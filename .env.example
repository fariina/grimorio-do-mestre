# Modo local; não exponha este modo à internet.
# Para hospedagem autenticada, consulte .env.production.example e docs/PUBLICACAO.md.
AUTH_MODE=local
HOST=127.0.0.1
PORT=3210
# Caminho relativo ou absoluto do banco; padrão data/grimorio.sqlite
DB_PATH=data/grimorio.sqlite
# Nenhuma chave de IA é necessária.
# Tradução automática opcional: instância LibreTranslate com idioma português.
# Prefira uma instância local; uma URL externa exige confirmação por ficha na UI.
TRANSLATION_URL=
TRANSLATION_API_KEY=
# en, es ou auto. O resultado pt precisa de revisão para PT-BR.
TRANSLATION_SOURCE=auto
