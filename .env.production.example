NODE_ENV=production
AUTH_MODE=github
HOST=0.0.0.0
PORT=10000
# Origem HTTPS exata, sem /auth/callback. No Render, pode usar RENDER_EXTERNAL_URL.
APP_ORIGIN=
TRUST_PROXY=true
# Conta verificada pelo conector GitHub: fariina. ID público e imutável.
GITHUB_OWNER_ID=84630880
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Gere no painel da hospedagem; mínimo de 32 caracteres aleatórios.
SESSION_SECRET=
DATA_DIR=/var/data
DB_PATH=/var/data/grimorio.sqlite
AUTH_DB_PATH=/var/data/auth.sqlite
BACKUP_DIR=/var/data/backups
MAX_UPLOAD_BYTES=60000000
# Tradução permanece opcional e desativada nesta etapa.
TRANSLATION_URL=
TRANSLATION_API_KEY=
TRANSLATION_SOURCE=auto
